{
	"schemaVersion": 1,
	"id": "trade-assistant",
	"version": "${version}",
	"name": "Trade Assistant",
	"description": "Quality-of-life tools for villager trading.",
	"authors": [
		"pedromartz"
	],
	"contact": {
		"homepage": "https://github.com/pedromrtz/trade-assistant"
	},
	"license": "MIT",
	"icon": "assets/trade-assistant/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.pedromartz.tradeassistant.TradeAssistantMod"
		],
		"client": [
			"com.pedromartz.tradeassistant.client.TradeAssistantClient"
		],
		"modmenu": [
			"com.pedromartz.tradeassistant.client.TradeAssistantModMenu"
		]
	},
	"mixins": [
		"trade-assistant.mixins.json",
		{
			"config": "trade-assistant.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_minimum}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
